# Copie para .env.local (no seu computador) ou cadastre na Vercel › Settings › Environment Variables.
# Onde achar: Supabase › Project Settings › API (ou "API Keys").

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública: "anon public" ou "Publishable key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta: "service_role" ou "Secret key". NUNCA coloque no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do site na Vercel (ex.: https://xeque-mate.vercel.app), sem barra no final
NEXT_PUBLIC_SITE_URL=
